{
  "manifest_version": 3,
  "name": "ClipIQ — Smart Clipboard History",
  "short_name": "ClipIQ",
  "version": "1.4.0",
  "description": "Copy anything, find it instantly. Smart clipboard cards, snippets, and AI search — private & local.",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "offscreen",
    "clipboardRead",
    "clipboardWrite",
    "alarms",
    "activeTab",
    "scripting",
    "contextMenus",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ClipIQ (Ctrl+Shift+V)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "open-clipiq": {
      "suggested_key": { "default": "Ctrl+Shift+V", "mac": "Command+Shift+V" },
      "description": "Open ClipIQ search"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/mellowtel.js", "js/mellowtel-content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
